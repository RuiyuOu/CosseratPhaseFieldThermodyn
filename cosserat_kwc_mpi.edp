// ---------------- output: P1 only for fields whose gradients are used later, P0 for the rest ----------
// P1 (point data): nodal solver fields that post-processing differentiates -- u, v, dtheta, theta_lattice, theta_dot, T, phi.
// P0 (cell data): element history and element-derived quantities, written unaveraged (exact solver values, sharp at grain boundaries).
// theta_lattice = smoothed grain angle theta_0 + rotation.
varf vP0P1([a], [w]) = int2d(Th)(a*w);
matrix Bp01 = vP0P1(Ph, Vh1);
real[int] lump(Vh1.ndof); { real[int] o0(nt); o0 = 1; lump = Bp01*o0; }
func int toP1(real[int] & a0, real[int] & o1v) { o1v = Bp01*a0; o1v = o1v ./ lump; return 0; }
real[int] cth0(nt), sth0(nt), gid(nt);
for (int k = 0; k < nt; k++) { real tg = thg(Th[k].label - 1); cth0[k] = cos(tg); sth0[k] = sin(tg); gid[k] = Th[k].label; }
string pvd = "";
string outbase = out; { int kk = out.rfind("/"); if (kk >= 0) outbase = out(kk+1:out.length-1); }
real t = 0;
func int writeVTK(string tag) {
  if (vtkon) {
    // committed element state (called after the step is committed): zero increments
    real[int] sva = dpa, svb = dpb, svc = dpc, svw = dwst;
    dpa = 0; dpb = 0; dpc = 0; dwst = 0;
    taus();
    // Cauchy stress sigma = (dpsi/dF) F^T / J at the element-mean deformation (sigma_ij: i = force direction)
    real[int] F11 = e11 + one, F22 = e22 + one;
    real[int] Jd = F11 .* F22; tmp = hy1 .* hx2; Jd -= tmp;
    real[int] q11 = PF11 .* F11; tmp = PF12 .* hy1; q11 += tmp; q11 = q11 ./ Jd;
    real[int] sg12 = PF11 .* hx2; tmp = PF12 .* F22; sg12 += tmp; sg12 = sg12 ./ Jd;
    real[int] sg21 = PF21 .* F11; tmp = PF22 .* hy1; sg21 += tmp; sg21 = sg21 ./ Jd;
    real[int] q22 = PF21 .* hx2; tmp = PF22 .* F22; q22 += tmp; q22 = q22 ./ Jd;
    real[int] sg33 = S33e ./ Jd;   // sigma_33 = S_33 / J (Vinet law, eosStress)
    // couple stress (referential)
    real[int] mc1(nt), mc2(nt);
    kwcStress(); mc1 = mxk; mc2 = myk;
    real[int] kpa = kp1, kpb = kp2;
    // element fields, written as P0 cell data. Not written because they are exact functions of what is:
    //   grain id = cell "Label" (triangles), theta0 = meta grain_theta0_rad[Label-1], slip_net = |p1|+|p2|+|p3|
    Ph f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15, f16, f17, f18, f19, f20, f21, f22, f23, f24, f25, f26, f27, f28, f29, f30, f31;
    f1[] = pa; f2[] = pb; f3[] = pc; f4[] = pathE; f5[] = pathP;
    f6[] = rhoS; f7[] = rhoG; f8[] = kpa; f9[] = kpb; f10[] = wst; f11[] = tauc;
    f12[] = ta; f13[] = tb; f14[] = tcc;
    f15[] = q11; f16[] = q22; f17[] = sg12; f18[] = sg21; f19[] = sg33;
    f20[] = mc1; f21[] = mc2; f22[] = Drate;
    f23[] = fp11; f24[] = fp12; f25[] = fp21; f26[] = fp22; f27[] = aa; f28[] = Jd; f29[] = psiF; f30[] = rhoMob; f31[] = etad;
    dpa = sva; dpb = svb; dpc = svc; dwst = svw;
    Wh [w1, w2, wth]; w1[] = V;                        // velocities (u_dot, theta_dot)
    Vh1 thdeg = th*180/pi, thtot = (th0s + th)*180/pi, thdot = wth, vx = w1, vy = w2;
    // MPI: gather to the global mesh (P1 vertex values = what savevtk writes for order 1; P0 owned elements)
    Vh1 lu1 = u1, lu2 = u2;
    Vh1G Gu1, Gu2, Gvx, Gvy, Gthdeg, Gthtot, Gthdot, GT, Gphi;
    Gu1[] = gath1(lu1[]); Gu2[] = gath1(lu2[]); Gvx[] = gath1(vx[]); Gvy[] = gath1(vy[]); Gthdeg[] = gath1(thdeg[]); Gthtot[] = gath1(thtot[]);
    Gthdot[] = gath1(thdot[]); GT[] = gath1(T[]); Gphi[] = gath1(phi[]);
    PhG g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15, g16, g17, g18, g19, g20, g21, g22, g23, g24, g25, g26, g27, g28, g29, g30, g31;
    g1[] = gathE(f1[]); g2[] = gathE(f2[]); g3[] = gathE(f3[]); g4[] = gathE(f4[]); g5[] = gathE(f5[]); g6[] = gathE(f6[]); g7[] = gathE(f7[]); g8[] = gathE(f8[]);
    g9[] = gathE(f9[]); g10[] = gathE(f10[]); g11[] = gathE(f11[]); g12[] = gathE(f12[]); g13[] = gathE(f13[]); g14[] = gathE(f14[]); g15[] = gathE(f15[]); g16[] = gathE(f16[]);
    g17[] = gathE(f17[]); g18[] = gathE(f18[]); g19[] = gathE(f19[]); g20[] = gathE(f20[]); g21[] = gathE(f21[]); g22[] = gathE(f22[]); g23[] = gathE(f23[]); g24[] = gathE(f24[]);
    g25[] = gathE(f25[]); g26[] = gathE(f26[]); g27[] = gathE(f27[]); g28[] = gathE(f28[]); g29[] = gathE(f29[]); g30[] = gathE(f30[]); g31[] = gathE(f31[]);
    int[int] ord(38); ord = 0; ord(0:6) = 1;           // order is per field: 7 P1 fields, then 31 P0 fields
    if (mpirank == 0)
    savevtk(out + "_" + tag + ".vtu", ThG, [Gu1, Gu2, 0], [Gvx, Gvy, 0], Gthdeg, Gthtot, Gthdot, GT, Gphi,
            g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15, g16, g17, g18, g19,
            g20, g21, g22, g23, g24, g25, g26, g27, g28, g29, g30, g31,
            dataname = "u v dtheta_deg theta_lattice_deg theta_dot T phi p1 p2 p3 slip_path_eff slip_path_phys rhoS rhoG kp_x kp_y wstar tau_c tau_1 tau_2 tau_3 sig_11 sig_22 sig_12 sig_21 sig_33 m_x m_y D_rate Fp_11 Fp_12 "
    + "Fp_21 Fp_22 w_cosserat J psi_elastic rho_mob eta_drag",
            order = ord, bin = true, floatsol = true, floatmesh = true);
    // ParaView time-series collection
    pvd = pvd + "    <DataSet timestep=\"" + t + "\" file=\"" + outbase + "_" + tag + ".vtu\"/>\n";
    if (mpirank == 0) { ofstream f(out + ".pvd");
      f << "<?xml version=\"1.0\"?>\n<VTKFile type=\"Collection\" version=\"0.1\">\n  <Collection>\n" << pvd << "  </Collection>\n</VTKFile>\n"; }
  }
  return 0;
}
// ---- GND from Curl Fp ----
// weak nodal curl per row j of Fp: c_j = d1 Fp_j2 - d2 Fp_j1,  int c_j w = -int (Fp_j2 dw/dx - Fp_j1 dw/dy) + int_dOmega (Fp_j2 n1 - Fp_j1 n2) w,
// lumped P1 mass; element mean of c; G_i = Fp_ij c_j (reference curl, Cermelli-Gurtin G = Fp Curl Fp)
real[int] GR1(nt), GR2(nt); GR1 = 0; GR2 = 0;
Ph fpA, fpB;
varf vCurlFp(un, w) = int2d(Th)(-(fpA*dx(w) - fpB*dy(w))) + int1d(Th, 1, 2, 3, 4)((fpA*N.x - fpB*N.y)*w);
func int syncP1(real[int] & a) { real[int] aa = a, ap; ChangeNumbering(Ap1, aa, ap); ChangeNumbering(Ap1, aa, ap, inverse = true, exchange = true); a = aa; return 0; }   // MPI: owner values on the overlap
real[int] lumpS = lump; syncP1(lumpS);
real[int] own1S = own1;   // P1 dofs owned by this rank
func int curlFpG(real[int] & g1, real[int] & g2) {
  Vh1 c1, c2;
  fpA[] = fp12; fpB[] = fp11; c1[] = vCurlFp(0, Vh1); syncP1(c1[]); c1[] = c1[] ./ lumpS;
  fpA[] = fp22; fpB[] = fp21; c2[] = vCurlFp(0, Vh1); syncP1(c2[]); c2[] = c2[] ./ lumpS;
  Ph c1e = c1, c2e = c2;
  g1 = fp11 .* c1e[]; tmp = fp12 .* c2e[]; g1 += tmp;   // G = Fp c
  g2 = fp21 .* c1e[]; tmp = fp22 .* c2e[]; g2 += tmp;
  return 0;
}
// ---------------- time loop ---------------------------------------------
strength();
localUpdate();
refreshTangent();

int nsteps = lrint(tend/dt);
int ntot = nrelax + nsteps;
real Tprev = 0;
real clk0 = clock(), wclk0 = mpiWtime();
real omg = 1; real[int] rprev(Wh.ndof), dr(Wh.ndof);

real[int] tna(nt), tnb(nt), tnc(nt), nna(nt), nnb(nt), nnc(nt), wn(nt);   // nna..nnc: zero (checkpoint layout)
 tna = 0; tnb = 0; tnc = 0; nna = 0; nnb = 0; nnc = 0; wn = 0;
real[int] Dmid(nt), Dimp(nt), Wpl(nt), dStore(nt); real dAlgStep = 0, dAlgCum = 0, dClipCum = 0; int nnegStep = 0;
real[int] pr(Wh.ndof), tv(Wh.ndof), rk(Wh.ndof), Anew(Wh.ndof), Dloc(nt), act(nt), drho(nt), Zst(nt), sa0(nt);
// mobile density, backward Euler: rho_M,n+1 = (rho_M,n + C2 Gamma rho_M*)/(1 + C2 Gamma), target and result floored at rho_Mmin
func int mobUpdate() {
  real[int] rf = rhoS + rhoG; rf *= 1./rhoFcut; rf = sqrt(rf); rf *= -1; rf += 1; rf *= rhoMsat;   // rho_M* = rho_Msat (1 - sqrt(rho_F/rho_Fcut))
  for [i, v : rf] v = max(v, rhoMmin);
  tmp = act; tmp *= C2M; rf = rf .* tmp; rhoM += rf; tmp += 1; rhoM = rhoM ./ tmp;
  for [i, v : rhoM] v = max(v, rhoMmin);
  return 0;
}
real[int] Upred(Wh.ndof); real tl = 0, ta0 = 0, ts = 0, duLast = 1; int nfail = 0, nretry = 0;
// ---- global iteration: full Newton (tangent rebuilt every -tanevery iterations), backtracking line search on ||R|| (Armijo, halving,
//   at most -lsmax times); convergence needs du < -tol and ||R|| <= -tolres * max(||R_0||, -resfloor) ----
real tolR = atof(arg("-tolres", "1e-6")), rFloor = atof(arg("-resfloor", "1e-8"));
int lsMax = atoi(arg("-lsmax", "6"));
real resLast = 0, res0Last = 0, tr = 0; int lsTot = 0, nDuOnly = 0;
real[int] Ubase(Wh.ndof), dU(Wh.ndof);
// linear solve with a check of the achieved residual; GMRES that misses the tolerance falls back to the direct solver
func int linSolve() {   // MPI: PETSc solve; the achieved residual is checked on the owned dofs
  tv = AeffM^-1*rhs;
  real[int] chk = Aeff*tv; chk -= rhs; chk = chk .* mask;
  real nb = sqrt(gdotW(rhs, rhs)); real rr = sqrt(gdotW(chk, chk))/max(nb, 1e-300);
  linResMax = max(linResMax, rr);
  if (!(rr < 1e3*linTol)) {
    nLinFall++; if (mpirank == 0) cout << "   Krylov solve reached only " << rr << " relative: direct (-petscfall) solve for this step" << endl;
    set(AeffM, sparams = pfx(fallOpt, "el_"), prefix = "el_"); tv = AeffM^-1*rhs;
    set(AeffM, sparams = pfx(elOpt, "el_"), prefix = "el_");
  }
  return 0;
}
func int newtonSolve(int mx, int itOff, string tg) {
  int it; real du = 1, rn = 0, r0 = 0;
  for (it = 0; it < mx; it++) {
    if (nanHit) break;
    curIt = itOff + it;
    real c0k = clock();
    mark(tg + "local plastic update (slip/GB-spin Newton per element)");
    localUpdate();
    if (nanE(dpa, "slip increment a") || nanE(dpb, "slip increment b") || nanE(dpc, "slip increment c") || nanE(dwst, "GB spin increment") || nanE(ta, "resolved shear stress a") || nanE(jdet, "J = det Ubar")) break;
    tl += clock() - c0k; c0k = clock();
    if (it % tanEvery == 0) { mark(tg + "tangent at the current iterate"); refreshTangent(); if (nanHit) break; }
    tr += clock() - c0k; c0k = clock();
    mark(tg + "residual (inertia + finite-strain elastic + KWC couple stress)");
    residual();
    if (nanV(rhs, "residual")) break;
    if (jBad) { nJBad++; if (mpirank == 0) cout << "   inadmissible iterate: lower bound of det F " << jbLast << " < -jmin " << jMin << " (or plastic increment |q| > 50, -expreject): abandoned" << endl; it = mx; break; }   // -> retry / clean stop
    rn = sqrt(gdotW(rhs, rhs)); if (it == 0) r0 = rn;
    ta0 += clock() - c0k; c0k = clock();
    if (it > 0 && !(rn < 1e4*max(r0, rFloor))) { if (mpirank == 0) cout << "   global iteration diverging (|R| " << rn << " vs |R0| " << r0 << "): abandoned" << endl; it = mx; break; }   // -> retry / clean stop
    if (it > 0 && du < tolU) {
      if (rn <= tolR*max(r0, rFloor)) break;                    // converged: increment and residual (local state is current)
      if (du < 0.01*tolU) {                                     // increment negligible (1e-2 tol): residual floor of the inexact local solve
        if (stagRes <= 0 || rn <= stagRes*tolR*max(r0, rFloor)) { nDuOnly++; break; }
        nStag++; if (mpirank == 0) cout << "   stagnation: du " << du << " but |R| " << rn << " > " << stagRes << " tolres |R0| (" << r0 << "): abandoned" << endl; it = mx; break;   // -> retry / clean stop
      }
    }
    mark(tg + "linear solve for (u, theta)");
    linSolve();
    if (nanV(tv, "Newton correction")) break;
    ts += clock() - c0k;
    // backtracking line search on ||R||; the last (smallest) candidate is tested too: if none reduces ||R|| the iterate is restored and the step fails
    Ubase = U; real w = 1; int ls, lsOk = 0;
      for (ls = 0; ls <= lsMax; ls++) {
        U = Ubase; dU = tv; dU *= w; U += dU; u1[] = U;
        mark(tg + "line search trial " + ls);
        localUpdate(); residual();
        real rt = sqrt(gdotW(rhs, rhs));
        if (jBad) { nJBad++; rt = 1e300; }                  // inadmissible candidate: backtrack
        if (rt == rt && rt <= (1 - 1e-4*w)*rn) { lsOk = 1; break; }
        w *= 0.5; lsTot++;
      }
    if (!lsOk) {
      U = Ubase; u1[] = U; nLsFail++;
        if (mpirank == 0) cout << "   line search failed: no candidate down to w = " << w*2 << " reduced |R| (" << rn << "): abandoned" << endl; it = mx; break;   // -> retry / clean stop
      }
      du = w*gmax(tv.linfty)/max(gmax(U.linfty), 1e-30);
      if (verbose) if (mpirank == 0) cout << "   it " << it << " du " << du << " |R| " << rn << " (|R0| " << r0 << ") step " << w << " locits " << nlocit << " locres " << locres << " polish " << lastPolishRes << " maxdp " << max(dpa.linfty, dpb.linfty, dpc.linfty) << endl;
  }
  duLast = du; resLast = rn; res0Last = r0;
  return it;
}
if (mpirank == 0) cout << "plate impact: up=" << pistUp << " ut=" << pistUt << " um/ns  j=" << jz << " um^2  muc=" << muc
     << "  dt=" << dt << "  steps=" << ntot << "  nt=" << ntG << "  ndof=" << WhG.ndof << "  MPI ranks=" << mpisize << " (rank-0 subdomain nt=" << nt << ")" << endl;
real Wplate = 0, resR = 0; int plateNeedReact = 0, plateBaseline = 0;   // resR: audit baseline of the plate-work ledger; plateBaseline 1: waiting for it after a restart without .plate
func int plateLog(real rres) {   // log columns W_plate, audit_full = (audit_residual - resR) + W_plate
  if (plateBaseline == 1) {
    if (!plateNeedReact) { resR = rres; Wplate = 0; plateBaseline = 2; }   // first completed step after the restart: its reaction is the first one known; the ledger starts here
    log << ",nan,nan";
  } else log << "," << Wplate << "," << (rres - resR + Wplate);
  return 0;
} real[int] fCprev(Wh.ndof); fCprev = 0;
// reaction force on the constrained dofs at the current state with V = Acc = 0 (static): f_c = -R_full (R = F_ext - M a - f_int on the constrained rows)
func int reactionNow() {
  pr = U; pr *= c0; rin = Mu*pr; rk = Mt*pr; rin += rk;
  real Tl = Tload; Tload = 0; localUpdate(); residual(); Tload = Tl;
  fCprev = Rfull; fCprev *= -1; fCprev = fCprev .* cdof;
  return 0;
}
func int saveCkF(int n, string fn) {   // MPI: gathered to the global mesh, written by rank 0 in the serial format
  real[int] gU = gathW(U), gV = gathW(V), gA = gathW(Acc), gT = gath1(T[]), gph = gath1(phi[]), gtR = gath1(thR[]);
  real[int] e1 = gathE(pa), e2 = gathE(pb), e3 = gathE(pc), e4 = gathE(rhoS), e5 = gathE(rhoG), e6 = gathE(kp1), e7 = gathE(kp2), e8 = gathE(wst);
  real[int] e9 = gathE(tna), e10 = gathE(tnb), e11 = gathE(tnc), e12 = gathE(nna), e13 = gathE(nnb), e14 = gathE(nnc), e15 = gathE(wn);
  real[int] e16 = gathE(pathE), e17 = gathE(pathP), e18 = gathE(fp11), e19 = gathE(fp12), e20 = gathE(fp21), e21 = gathE(fp22), eM = gathE(rhoM);
  if (mpirank == 0) {
    { ofstream f(fn);
      f.precision(17);
      f << n << endl << t << " " << Tload << " " << Wext << " " << Dcum << " " << E0 << " " << nneg << endl;
      f << gU << gV << gA << e1 << e2 << e3 << e4 << e5 << e6 << e7 << e8 << e9 << e10 << e11 << e12 << e13 << e14 << e15 << gT << gph << gtR << e16 << e17 << e18 << e19 << e20 << e21;
    }
    { ofstream f(fn + ".rhoM"); f.precision(17); f << n << endl << eM; }   // mobile density (side file: the main checkpoint format is unchanged)
  }
  { real[int] qf = gathW(fCprev);
    if (mpirank == 0) { ofstream f(fn + ".plate"); f.precision(17); f << "PLATEv2" << endl << n << endl << Wplate << endl << resR << endl << plateBaseline << endl << qf << endl << "END" << endl; } }   // plate ledger and the last reaction force (side file)
  { real[int] q1 = gathE(GR1), q2 = gathE(GR2);
    if (mpirank == 0) { ofstream f(fn + ".gnd"); f.precision(17); f << n << endl << q1 << q2; } }   // Curl-Fp GND reference (side file)
  return 0;
}
// checkpoints are written to <name>.new (+ side files) and then renamed, the main file last: a crash during the write leaves the previous consistent set
func int saveCkA(int n, string fn) {
  string gen = fn + ".g" + n;
  if (isRoot()) { int sq = 0; while (exec("test -e " + gen + "_" + sq) == 0) sq++; gen = gen + "_" + sq; }   // a never-used name: the committed generation is never overwritten
  saveCkF(n, gen);
  if (isRoot()) {
    string chk = "test -s " + gen + " && test -s " + gen + ".rhoM";
    chk = chk + " && test -s " + gen + ".plate";
    chk = chk + " && test -s " + gen + ".gnd";
    if (exec(chk) != 0) { if (mpirank == 0) cout << "CHECKPOINT WARNING: generation " << gen << " is incomplete: the manifest keeps pointing to the previous generation" << endl; return 1; }
    string pg = "-";
    if (exec("test -s " + fn + ".manifest") == 0) { int a, b2; string g0; ifstream fm(fn + ".manifest"); fm >> a >> g0; if (g0 != "") pg = g0; }
    { ofstream fm(fn + ".manifest.tmp"); fm << n << endl << gen << endl << pg << endl << gndCG << endl; }
    // atomic commit of the whole set = one rename of the manifest; then drop all generations except the new and the previous one; then refresh the plain names (hard links, convenience only: restart prefers the manifest)
    exec("mv -f " + fn + ".manifest.tmp " + fn + ".manifest; for f in " + fn + ".g[0-9]*; do case \"$f\" in " + gen + "|" + gen + ".*|" + pg + "|" + pg + ".*) ;; *) rm -f \"$f\";; esac; done; "
         + "for x in '' .rhoM .gnd .plate; do [ -e " + gen + "$x ] && ln -f " + gen + "$x " + fn + "$x; done; true");
  }
  return 0;
}
func int saveCk(int n) { return saveCkA(n, out + "_ck.txt"); }
if (restart != "") {
  ifstream f(restart);
  int nn; f >> nn; f >> t >> Tload >> Wext >> Dcum >> E0 >> nneg;
  { // MPI: read the global (serial-format) checkpoint on every rank and restrict it to the subdomain
    real[int] gU(WhG.ndof), gV(WhG.ndof), gA(WhG.ndof), gT(Vh1G.ndof), gph(Vh1G.ndof), gtR(Vh1G.ndof);
    real[int] e1(ntG), e2(ntG), e3(ntG), e4(ntG), e5(ntG), e6(ntG), e7(ntG), e8(ntG), e9(ntG), e10(ntG), e11(ntG), e12(ntG), e13(ntG), e14(ntG), e15(ntG);
    real[int] e16(ntG), e17(ntG), e18(ntG), e19(ntG), e20(ntG), e21(ntG);
    f >> gU >> gV >> gA >> e1 >> e2 >> e3 >> e4 >> e5 >> e6 >> e7 >> e8 >> e9 >> e10 >> e11 >> e12 >> e13 >> e14 >> e15 >> gT >> gph >> gtR >> e16 >> e17 >> e18 >> e19 >> e20 >> e21;
    U = RW*gU; V = RW*gV; Acc = RW*gA; T[] = R1*gT; phi[] = R1*gph; thR[] = R1*gtR;
    pa = e1(n2o); pb = e2(n2o); pc = e3(n2o); rhoS = e4(n2o); rhoG = e5(n2o); kp1 = e6(n2o); kp2 = e7(n2o); wst = e8(n2o);
    tna = e9(n2o); tnb = e10(n2o); tnc = e11(n2o); nna = e12(n2o); nnb = e13(n2o); nnc = e14(n2o); wn = e15(n2o);
    pathE = e16(n2o); pathP = e17(n2o); fp11 = e18(n2o); fp12 = e19(n2o); fp21 = e20(n2o); fp22 = e21(n2o);
  }
  u1[] = U;
  { // mobile density: side file <restart>.rhoM, else (relaxed checkpoint) the quasi-steady value
    int nm = -1;
    if (exec("test -s " + restart + ".rhoM") == 0) { ifstream fm(restart + ".rhoM"); fm >> nm; if (nm == nn) { real[int] gm(ntG); fm >> gm; rhoM = gm(n2o); } }
    if (nm == nn) { if (mpirank == 0) cout << "rho_M read from " << restart << ".rhoM" << endl; }
    else { real[int] rf = rhoS + rhoG; real[int] q = rf; q *= 1./rhoFcut; q = sqrt(q); q *= -1; q += 1; q *= rhoMsat;
           for [i, v : q] v = max(rhoMmin, min(v, rf[i])); rhoM = q; if (mpirank == 0) cout << "rho_M initialised quasi-steady (no side file)" << endl; }
  }
  {   // plate work + last reaction: side file <restart>.plate, else cumulative work restarts at 0 and the reaction is recomputed
    int npl = -1, okp = 0, plfmt = 0;   // plfmt 3 = PLATEv2 (tag, n, W, resR, state, vector, END)
    string pf = restart + ".plate"; int plN = WhG.ndof;
    if (exec("test -s " + pf) == 0) {
      // The file is validated completely BEFORE any array is read (a failed array read is fatal in FreeFem): exact token count, tag and END,
      // every token after the tag numeric, step/state/array-length tokens integers (state in 0..2), array length = N of the current mesh.
      string awkP = " -v N=" + plN + " -v o=";
      string awkQ = " -v ns=";
      string awkR = " -v E=";
      string awkS = " ";
      awkS = awkS + "'function num(s){return s ~ /^[-+]?([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][-+]?[0-9]+)?$/} ";
      awkS = awkS + "{for(i=1;i<=NF;i++){t++;v[t]=$i}} END{ok=(t==o+ns+1+N+E); ";
      awkS = awkS + "if(ok&&o==1) ok=(v[1]~/^PLATEv2$/&&v[t]~/^END$/); ";
      awkS = awkS + "for(i=o+1;ok&&i<=t-E;i++) if(!num(v[i])) ok=0; ";
      awkS = awkS + "if(ok) ok=(v[o+ns+1]~/^[0-9]+$/&&v[o+ns+1]+0==N&&v[o+1]~/^[0-9]+$/); ";
      awkS = awkS + "if(ok&&ns==4) ok=(v[o+4]~/^[0-2]$/); if(ok&&ns==2) ok=!(v[5]+0==N&&v[4]~/^[0-2]$/); ";
      awkS = awkS + "exit !ok}'";
      awkS = awkS + " ";
      if (exec("head -c 7 " + pf + " | grep -q PLATEv2") == 0) { if (exec("awk" + awkP + "1" + awkQ + "4" + awkR + "1" + awkS + pf) == 0) plfmt = 3; }
      if (plfmt > 0) {
        ifstream fp(pf); string tok = ""; real w0 = 0, r0v = 0; int b0 = 0; real[int] qv(plN); qv = 0;
        if (plfmt == 3) { fp >> tok >> npl >> w0 >> r0v >> b0; }
        fp >> qv;
        okp = (npl == nn && b0 >= 0 && b0 <= 2);
        if (okp) { Wplate = w0; resR = r0v; plateBaseline = b0; real[int] ql = RW*qv; fCprev = ql;
          if (mpirank == 0) cout << "plate ledger read from " << pf << " (layout " << "PLATEv2" << "): W_plate " << w0 << ", audit baseline " << r0v << ", state " << b0 << endl; }
      }
    }
    if (!okp) { Wplate = 0; resR = 0; plateBaseline = 1; if (mpirank == 0) cout << "NOTE: no usable " << pf << " for step " << nn << " (missing, other step, unrecognised layout or incomplete): the plate-work ledger and audit_full are UNAVAILABLE for the first step after the restart (nan) and start from a new baseline after it" << endl; }
    plateNeedReact = !okp;
  }
  {   // Curl-Fp GND reference: side file <restart>.gnd; the relaxed checkpoint recomputes it below (relaxfix reset)
    int ng = -1;
    if (exec("test -s " + restart + ".gnd") == 0) { ifstream fg(restart + ".gnd"); fg >> ng; if (ng == nn) { real[int] q1(ntG), q2(ntG); fg >> q1 >> q2; GR1 = q1(n2o); GR2 = q2(n2o); } }
    if (ng == nn && max(manGndcg, 0) != gndCG) {   // the stored reference was computed with the other curl convention: never subtract it
      if (mpirank == 0) cout << "RESTART ERROR: the stored GND reference uses -gndcg " << max(manGndcg, 0) << " but this run has -gndcg " << gndCG << ": restart with the same -gndcg" << endl; exit(4); }
    if (ng == nn) if (mpirank == 0) cout << "GND reference read from " << restart << ".gnd" << endl;
    else if (nn != nrelax) if (mpirank == 0) cout << "WARNING: no " << restart << ".gnd for step " << nn << ": GND reference set to 0" << endl;
  }
  if (mpirank == 0) cout << "restarted from " << restart << " at step " << nstart << " t=" << t << endl;
  // keep the ParaView time series written before the restart
  if (exec("test -s " + out + ".pvd") == 0) { ifstream fp(out + ".pvd"); string ln;   // (a restart under a new -out has no earlier series)
    while (fp.good()) { getline(fp, ln); if (ln.find("<DataSet") >= 0) pvd = pvd + ln + "\n"; } }
  // started from the relaxed checkpoint (saved at n = nrelax BEFORE the end-of-relaxation reset): apply that reset now
  bool didReset = false;
  if (nn == nrelax) {
    V = 0; Acc = 0; Wext = 0; Dcum = 0; nneg = 0; T = T0; Tn = T0;
    rhoS = rho0; rhoM = rho0; thR = th; rhoG = 0; didReset = true;
    curlFpG(GR1, GR2);
    if (mpirank == 0) cout << "relaxfix: end-of-relaxation reset applied to the relaxed checkpoint" << endl;
  }
  if (nn >= nrelax) { real[int] va = V .* bcm, aa = Acc .* bcm; fixBCkin(t);
    if (mpirank == 0) cout << "bckin: prescribed-dof kinematics reset on restart (max |v| " << va.linfty << ", max |a| " << aa.linfty << " before)" << endl; }
  strength(); localUpdate(); refreshTangent();
  if (didReset) { E0 = kinU() + kinT() + elasticEnergy() + storedEnergy() + heat(); if (mpirank == 0) cout << "relaxfix: E0=" << E0 << endl; }
}
// ---- run metadata (JSON) for later re-derivation of quantities ----
if (nstart == 0 && mpirank == 0) {
  ofstream f(out + "_meta.json");
  f.precision(10);
  f << "{\n";
  f << " \"units\": {\"length\": \"um\", \"time\": \"ns\", \"stress\": \"GPa\", \"temperature\": \"K\", \"density\": \"1e3 kg/m3\", \"energy_per_thickness\": \"GPa um^2 = 1e-3 J/m\"},\n";
  f << " \"mesh\": \"" << mfile << "\", \"j_um2\": " << jz << ", \"load\": \"plate (left edge clamped, right edge moving, top and bottom free)\", \"plate_un_um_ns\": " << pistUp << ", \"plate_ut_um_ns\": " << pistUt << ", \"ramp_ns\": " << pistTr << ", \"hold_ns\": " << pistTh << ",\n";
  f << " \"tend_ns\": " << tend << ", \"dt_ns\": " << dt << ", \"nrelax\": " << nrelax << ",\n";
  f << " \"mu_c\": " << muc << ", \"rho\": " << rho << ", \"C_lattice\": {\"xxxx\": " << Clxx << ", \"yyyy\": " << Clyy << ", \"xxyy\": " << Clxy << ", \"xyxy\": " << Clss << ", \"xxzz\": " << Clxz << ", \"yyzz\": " << Clyz << "},\n";
  f << " \"lattice_frame\": \"x=[110], y=[001], z=[-110]\",\n";
  f << " \"slip_systems_lattice\": [";
  for (int a = 0; a < 3; a++) f << (a ? ", " : "") << "{\"s\": [" << slx[a] << ", " << sly[a] << "], \"n\": [" << -sly[a] << ", " << slx[a] << "], \"f\": " << fsa[a] << "}";
  f << "],\n";
  f << " \"grain_theta0_rad\": ["; for (int g = 0; g < 8; g++) f << (g ? ", " : "") << thg(g); f << "],\n";
  f << " \"hardening\": {\"tau0\": " << tau0 << ", \"lambda_T\": " << lamT << ", \"mu\": " << mu << ", \"b_um\": " << b << ", \"rho0_um2\": " << rho0 << ", \"K\": " << Kkmt << ", \"d_um\": " << dkmt << ", \"chi\": " << chi << ", \"alpha_mu\": " << alphaMu << "},\n";
  f << " \"rate\": {\"gdot0_per_ns\": " << g0 << ", \"m\": " << mexp << ", \"B0_GPa_ns\": " << B0 << "},\n";
  f << " \"mobile_drag\": {\"rho_m\": \"min(rho_M, rho_S + rho_G), rho_M evolved\", \"vc_um_per_ns\": " << vcrel << ", \"rhoMsat\": " << rhoMsat << ", \"C2M\": " << C2M << ", \"rhoFcut\": " << rhoFcut << ", \"rhoMmin\": " << rhoMmin << ", \"eta_d\": \"B0 (T/T0)/(b^2 rho_m) sqrt(1+(b tau/(v_c B))^2)\"},\n";
  f << " \"safeguards\": {\"jmin\": " << jMin << ", \"stagres\": " << stagRes << ", \"phitol\": " << phiTol << ", \"phikkt\": " << phiKktTol << ", \"phimaxit\": " << phiMaxIt << "},\n";
  f << " \"robustness\": {\"spinbranch\": " << spinCap << ", \"maxit\": " << maxit << ", \"maxitretry\": " << maxitRetry << ", \"ckroll\": " << ckRoll << ", \"softmin\": " << softMin << ", \"gnd\": \"curl Fp\", \"recovery\": \"Ask 2019 sweeping, C_A = " << CA << " um\"},\n";
  f << " \"elastic_law\": {\"eos\": \"vinet\", \"K0_GPa\": " << K0eos << ", \"Kprime\": " << Kpeos << ", \"integration\": \"3 Gauss points (edge midpoints)\"},\n";
  f << " \"tangent\": {\"mode\": \"exact Gauss-point Hessian\", \"fdk\": " << fdK << ", \"fdq\": " << fdQ << ", \"polish\": " << nPolish << "},\n";
  f << " \"mpi\": {\"ranks\": " << mpisize << ", \"overlap\": 1, \"petsc\": \"" << elOpt << "\"},\n";
  f << " \"newton\": {\"mode\": \"full\", \"tol_du\": " << tolU << ", \"tolres\": " << tolR << ", \"resfloor\": " << rFloor << ", \"lsmax\": " << lsMax << ", \"maxit\": " << maxit << "},\n";
  f << " \"thermal\": {\"T0\": " << T0 << ", \"rhoC\": " << rhoC << ", \"k\": " << kth << "},\n";
  f << " \"kwc\": {\"f0\": " << f0 << ", \"a\": " << aK << ", \"s\": " << sK << ", \"delta\": " << dlt << ", \"eta_phi0\": " << etaPhi0 << ", \"Q_phi\": " << Qphi << ", \"etaphimin\": " << phiArrMin << ", \"eta_star0\": " << etaStar0 << ", \"C_D\": " << CD
    << ", \"g\": \"-2[phi + ln(1-phi)]\", \"h\": 1, \"f\": \"(1-phi)^2/2\", \"spin_friction\": \"eta_s = 2 eta_star0/(1-phi)^2\", \"phi_max\": " << phimax << "},\n";
  f << " \"kinematics\": \"finite deformation: F = I + grad u = R(theta) Ubar Fp, Fp(0) = I in the grain-rotated reference lattice; Vinet + isochoric cubic Green-strain energy + 2 mu_c a^2, a = (Ubar_21 - Ubar_12)/2, at 3 Gauss points per P2 triangle\",\n";
  f << " \"fields_note\": \"Point data (P1, nodal): u, v, dtheta_deg, theta_lattice_deg, theta_dot, T, phi -- the fields differentiated in post-processing. ";
  f << "Cell data (P0, one value per triangle, exact solver values at the element-mean deformation): p1-p3 (accumulated slip), slip paths, rhoS, rhoG, kp, wstar, tau_c, tau_1-3 (Mandel resolved shear stress M:s(x)n), ";
  f << "Cauchy stress sig_ij = (P F^T/J)_ij with i the force direction, sig_33, referential couple stress m, D_rate, Fp_ij (plastic distortion, reference frame), w_cosserat = (Ubar_21-Ubar_12)/2, J = det F, "
    << "psi_elastic (Vinet + Cosserat energy density per reference area, element mean). kp_x, kp_y are zero (kept for the file layout). ";
  f << "Cells include the boundary edges (line cells); use triangle cells only. Grain id = cell Label of triangles. ";
  f << "Derived in paraview_derived.py: theta0, slip_net, drag_eta, strain measures. ";
  f << "Coordinates and u are referential (Lagrangian); use u to warp. ";
  f << "theta_dot in rad/ns, D_rate in GPa/ns, rho in um^-2.\"\n";
  f << "}\n";
}
for (int n = nstart + 1; n <= ntot; n++) {
  bool relax = (n <= nrelax);
  if (!relax) t += dt;
  Tprev = Tload;
  real etaPhi = (relax ? etaPhiRelax : etaPhi0);
  Un = U;
  pr = U; pr *= c0; tv = V; tv *= c1; pr += tv; pr += Acc;
  rin = Mu*pr; rk = Mt*pr; rin += rk;
  dpa = 0; dpb = 0; dpc = 0; dwst = 0;
  curStep = n; curIt = -1; curT = t;
  mark("step start: phase-field weights, strength and drag");
  updatePhi2();
  strength();
  // predictor U + dt V (only the starting guess of the full Newton iteration)
  tv = V; tv *= dt; U += tv;
  if (!relax) { U = U .* mask; tv = pistm; tv *= -pistonDisp(t); U += tv; tv = pistmT; tv *= pistonDispU(t, pistUt); U += tv; }   // shear plate: every prescribed dof set exactly (wall 0, plate -d_n, +d_t)
  u1[] = U;
  Upred = U;
  mark("predictor (U + dt V, plate displacement)"); nanV(U, "predicted displacement");
  int it; real du = 1;
  tl = 0; ta0 = 0; ts = 0; tr = 0;
  it = newtonSolve(maxit, 0, "global it: "); du = duLast;
  real gUl = gmax(U.linfty); bool okStep = (it < maxit) && (gUl < 1e30) && (gUl == gUl) && !nanHit;
  if (!okStep) {
    nfail++;
    if (mpirank == 0) cout << "step " << n << " t=" << t << ": global iteration not converged (" << it << " its, du " << du << ", |R| " << resLast << " of |R0| " << res0Last << ")" << endl;
    if (!nanHit) {   // restore the predictor, fresh tangent at it, re-solve with more iterations
      U = Upred; u1[] = U; dpa = 0; dpb = 0; dpc = 0; dwst = 0;
      mark("retry: restore predictor + fresh tangent");
      localUpdate(); refreshTangent(); nretry++;
      it = newtonSolve(maxitRetry, 1000, "retry: "); du = duLast;
      gUl = gmax(U.linfty); okStep = (it < maxitRetry) && (gUl < 1e30) && (gUl == gUl) && !nanHit;
      if (mpirank == 0) cout << "   retry with fresh tangent: " << (okStep ? "converged" : "FAILED") << " in " << it << " its" << endl;
    }
    if (!okStep) {   // stop cleanly at the end of step n-1 (nothing of step n is committed yet except U)
      U = Un; u1[] = U; dpa = 0; dpb = 0; dpc = 0; dwst = 0;
      if (!relax) t -= dt; Tload = Tprev;
      saveCk(n - 1); localUpdate();
      if (vtkon) writeVTK("stall" + n);
      if (mpirank == 0) { ofstream fs(out + "_NOCONV.txt"); fs << "global iteration did not converge at step " << n << " (t=" << (t + (relax ? 0 : dt)) << " ns) after "
          << "a retry with a fresh tangent; checkpoint = end of step " << (n - 1) << "." << endl; }
      if (mpirank == 0) cout << "NOCONV: stopped; checkpoint written at step " << (n - 1) << endl;
      break;
    }
  }
  if (verbose) if (mpirank == 0) cout << "step " << n << " t " << t << " iters " << it << " |R| " << resLast << "/" << res0Last << " local " << tl << " s, tangent " << tr << " s [element " << tTanEl << " (FD " << tTanFD << ", Kc assembly " << tTanKc << "), global assembly " << tTanAsm << " (ILU " << tTanPre << ")], residual " << ta0 << " s, solve " << ts << " s" << endl;
  tTanEl = 0; tTanAsm = 0; tTanFD = 0; tTanKc = 0; tTanPre = 0;
  mark("converged: final local update"); localUpdate();
  mark("commit: Newmark update, external work, dissipation");
  // Newmark update
  Anew = U; Anew -= Un; Anew *= c0; tv = V; tv *= c1; Anew -= tv; Anew -= Acc;
  tv = Acc; tv += Anew; tv *= 0.5*dt; V += tv; Acc = Anew;
  if (!relax) fixBCkin(t);   // exact kinematics on the prescribed dofs
  {   // work of the prescribed-motion dofs: f_c = -R_full (reaction of the discrete equations incl. inertia), trapezoidal in time
    real[int] fc = Rfull; fc *= -1; fc = fc .* cdof;
    if (!relax && !plateNeedReact) { real[int] fa = fc; fa += fCprev; fa *= 0.5; real[int] dUc = U; dUc -= Un; dUc = dUc .* cdof; Wplate += gdotS(fa, dUc); }
    fCprev = fc; plateNeedReact = 0;   // after a restart without .plate the first increment is skipped (no previous reaction)
  }
  // dissipation and commit
  // dissipation with midpoint driving forces: consistent with the trapezoidal energy identity
  taus();
  tmp = ta + tna; tmp *= 0.5; Dmid = tmp .* dpa;
  tmp = tb + tnb; tmp *= 0.5; tmp = tmp .* dpb; Dmid += tmp;
  tmp = tcc + tnc; tmp *= 0.5; tmp = tmp .* dpc; Dmid += tmp;
  Dimp = ta .* dpa; tmp = tb .* dpb; Dimp += tmp; tmp = tcc .* dpc; Dimp += tmp;    // tau_{n+1} dgamma: >= 0 for a converged backward-Euler step
  Wpl = abs(Dimp);
  tna = ta; tnb = tb; tnc = tcc;
  Dloc = Dimp;   // heat source: implicit dissipation (>= 0 for a converged backward-Euler step)
  tmp = Dmid - Dimp; tmp = tmp .* areas; dAlgStep = gsumE(tmp);   // midpoint - implicit (algorithmic part, O(dt^2) per step)
  tmp = tstar .* dwst; Dloc += tmp; wn = wloc;   // implicit spin: tau*_{n+1} dw* = eta_s dw*^2/dt >= 0
  act = abs(dpa); act *= fs1; tmp = abs(dpb); tmp *= fs2; act += tmp; tmp = abs(dpc); tmp *= fs3; act += tmp;
  tmp = rhoS; dStore = sqrt(tmp); dStore *= Kkmt/b; dStore = dStore .* act;            // KMT storage (>= 0)
  drho = rhoS; drho *= -2*dkmt/b; drho = drho .* act; drho += dStore;                   // + dynamic recovery
  {
    // phase field: backward Euler, Newton on the log coupling g'(phi) = 2 phi/(1-phi), g'' = 2/(1-phi)^2
    mark("commit: phase-field (KWC phi) Newton solve");
    phin = phi;
    Ph Nd = NKWC(gtx^2 + gty^2), rr; rr[] = rhoS;
    Vh1 phik = phi;
    int phiConv = 0, phiNit = 0; real phiKktV = 0;
    // KKT residual of the bound-constrained phase equation at the clipped iterate (r = nodal residual density of the nonlinear equation;
    // free dofs: r = 0; at phi = 0: r >= 0; at phi = phimax: r <= 0); an increment test alone can pass on a clipped non-solution
    varf vphD(uu, xi) = int2d(Th)((etaPhi*phArr/dt + f0 + f0*sK*Nd*2/(1-phi)^2)*xi);
    varf vphR(uu, xi) = int2d(Th)((etaPhi*phArr/dt*(phi - phin) + f0*phi + f0*sK*Nd*2*phi/(1-phi) - (f0 - 0.5*chi*mu*b*b*rr))*xi
                                  + f0*aK^2*(dx(phi)*dx(xi) + dy(phi)*dy(xi)));
    varf vphA(phi, xi) = int2d(Th)((etaPhi*phArr/dt + f0 + f0*sK*Nd*2/(1-phik)^2)*phi*xi
                                      + f0*aK^2*(dx(phi)*dx(xi) + dy(phi)*dy(xi)));
    varf vphB(phi, xi) = int2d(Th)(etaPhi*phArr/dt*phin*xi + (f0 - 0.5*chi*mu*b*b*rr)*xi
                                    - f0*sK*Nd*(2*phik/(1-phik) - 2*phik/(1-phik)^2)*xi);
    varf vphL(phi, xi) = int2d(Th, qft=qf1pTlump)(phi*xi);
    for (int kn = 0; kn < phiMaxIt; kn++) {
      phiNit = kn + 1;
      {
        // bound-constrained Newton step by a primal-dual active set (= semismooth Newton on the Lagrange-multiplier system).  Multiplier of a bound = the nodal
        // residual r; a node is active when mult/d + (phi - bound) crosses the bound, i.e. when the diagonally scaled Newton step phi - r/d (not the full coupled step) would leave [0, phimax].
        // Active nodes are eliminated exactly (phi = bound, their columns moved to the right-hand side); the free nodes solve the reduced system.  No penalty parameter.
        real[int] rk = vphR(0, Vh1), dk = vphD(0, Vh1); real[int] pk = phi[]; real tolAct = 0.1*phiKktTol; real[int] au(Vh1.ndof), al(Vh1.ndof);
        for (int i = 0; i < Vh1.ndof; i++) { real stp = pk[i] - rk[i]/max(dk[i], 1e-300); au[i] = (stp >= phimax - tolAct) ? 1. : 0.; al[i] = (stp <= tolAct) ? 1. : 0.; }   // tolAct: a node whose multiplier is ~0 (degenerate, phi = bound) must not flip on and off with round-off
        syncPen(au); syncPen(al);
        for (int i = 0; i < Vh1.ndof; i++) { au[i] = (au[i] > 0.5) ? 1. : 0.; al[i] = (al[i] > 0.5) ? 1. : 0.; nPhiPin += (au[i] + al[i])*own1S[i]; }
        real[int] pmask = au; pmask += al; real[int] xpin = au; xpin *= phimax; real[int] fr(Vh1.ndof); fr = 1.; fr -= pmask;
        matrix Aphl = vphA(Vh1, Vh1); real[int] bph = vphB(0, Vh1); matrix Lm = vphL(Vh1, Vh1);
        real[int] axp = Aphl*xpin; real[int] lxp = Lm*xpin;
        matrix Fr = fr, Pm = pmask;
        matrix Am = Fr*Aphl; Am = Am*Fr; matrix Lp = Pm*Lm; Am = Am + Lp;       // free block + lumped identity rows on the active nodes
        bph -= axp; bph = bph .* fr; bph += lxp;                                // free rows: b - A_fa x_a;  active rows: lumped mass * bound
        Ap1 = Am; set(Ap1, sparams = pfx(p1Opt, "ph_"), prefix = "ph_");
        phi[] = Ap1^-1*bph;
        for (int i = 0; i < Vh1.ndof; i++) if (pmask[i] > 0.5) phi[][i] = xpin[i];   // active nodes exactly on their bound (an iterative solve leaves ~1e-14)
      }
      for [i, pv : phi[]] pv = max(0., min(phimax, pv));
      real[int] ddp = phi[]; ddp -= phik[]; real dmx = gmax(ddp.linfty);
      phik = phi;
      if (dmx < phiTol) {
        phiConv = 1;
        {   // identical iterates from here on: the KKT test decides once
          // violation measured as a Newton step in phi units: nodal residual density / lumped diagonal of the (mass part of the) Jacobian
          real[int] rr1 = vphR(0, Vh1), dg1 = vphD(0, Vh1); real[int] vv = phi[]; real vmax = 0;
          for [i, v : rr1] { real pv = vv[i]; real viol = (pv <= 1e-9) ? max(-v, 0.) : ((pv >= phimax - 1e-9) ? max(v, 0.) : abs(v)); vmax = max(vmax, viol/max(dg1[i], 1e-300)*own1S[i]); }
          phiKktV = gmaxS(vmax);
          if (phiKktV > phiKktTol) phiConv = 0;
        }
        break;
      }
    }
    if (!phiConv) {   // phase-field Newton did not reach -phitol and the KKT test: stop instead of silently committing an unconverged phi
      nPhiFail++;
      if (mpirank == 0) { ofstream fs(out + "_NOCONV.txt"); fs << "phase-field solve did not converge (|dphi| tolerance " << phiTol << ", KKT violation (Newton step in phi) " << phiKktV << " vs " << phiKktTol << ", " << phiNit << " its) at step " << n << " (t=" << t
          << " ns). The step is NOT checkpointed; restart from the last periodic checkpoint (_ck.txt / _ckroll*.txt)." << endl; }
      if (mpirank == 0) cout << "PHASE-NOCONV: stopped at step " << n << endl;
      break;
    }
    Ph dph = phi - phin, ph2 = phi, eph = etaPhi*phArr;
    // recovery by boundary sweeping (Ask et al. 2019, Eqs. 80 and 133): C_D max(dphi, 0) tanh(C_A^2 |grad theta_t|^2) rho_S, active only behind a sweeping boundary (phi increasing)
    tmp = dph[]; for [i, v : tmp] v = max(v, 0.);
    { real[int] gq = gsx; real[int] gq2 = gsy; gq = gq .* gq; gq2 = gq2 .* gq2; gq += gq2; gq *= CA*CA;
      for [i, v : gq] v = tanh(v); tmp = tmp .* gq; }
    tmp *= CD; tmp = tmp .* rhoS; drho -= tmp;
    tmp = dph[] .* dph[]; tmp = tmp .* eph[]; tmp *= 1./dt; Dloc += tmp;
    Zst = ph2[]; Zst *= 0.5*chi*mu*b*b;
  }
  {   // Clausius-Duhem cap on storage: Z dStore <= sum|tau dgamma|  (inactive in normal plastic flow: Z dStore ~ 0.08 phi tau_c dgamma)
    real[int] cap = Wpl; tmp = Zst; tmp += 1e-300; cap = cap ./ tmp;
    real[int] excess = dStore - cap; tmp = abs(excess); excess += tmp; excess *= 0.5;   // max(dStore - cap, 0)
    drho -= excess; dStore -= excess;
  }
  tmp = Zst .* drho; Dloc -= tmp;
  nnegStep = 0; for [i, dv : Dloc] if (dv < -1e-14) nnegStep += lrint(ownE[i]);
  nnegStep = lrint(gsum(nnegStep)); nneg += nnegStep;   // owned elements only
  dAlgCum += dAlgStep;
  pa += dpa; pb += dpb; pc += dpc; wst += dwst; rhoS += drho;
  fp11 = tf11; fp12 = tf12; fp21 = tf21; fp22 = tf22;
  tmp = abs(dpa); pathE += tmp; tmp = abs(dpb); pathE += tmp; tmp = abs(dpc); pathE += tmp; pathP += act;
  {   // the floor adds stored energy Z * (rho_after - rho_before): subtract it from the heat as well (actual increment)
    real[int] rpre = rhoS; for [i, rv : rhoS] rv = max(rv, 1e-3);
    real[int] exf = rhoS - rpre; tmp = Zst .* exf; Dloc -= tmp; drho += exf;
    real[int] flg(nt); for [i, v : exf] flg[i] = (v > 0) ? 1. : 0.;
    real nfe = gsumEs(flg); if (nfe > 0) { nFloorEl += lrint(nfe); nFloorSteps++; tmp = tmp .* areas; EfloorCum += gsumEs(tmp); }
  }
  mark("commit: SSD storage/recovery, GND, mobile density"); nanE(drho, "SSD increment"); nanE(Dloc, "dissipation");
  // GND: |Fp Curl Fp - G_R|/b
  { real[int] g1(nt), g2(nt); curlFpG(g1, g2); g1 -= GR1; g2 -= GR2; tmp = g1 .* g1; tmp2 = g2 .* g2; tmp += tmp2; rhoG = sqrt(tmp); }
  rhoG *= 1./b;
  mobUpdate();   // mobile density with the end-of-step forest density rho_S,n+1 + rho_G,n+1
  Dsrc[] = Dloc; Drate = Dloc; Drate *= 1./dt;
  Dcum += gsum(int2d(Th)(ownP*Dsrc));
  // heat
  Tn = T;
  real[int] rT = vTr(0, Vh1);
  mark("commit: heat equation solve");
  T[] = AThM^-1*rT;
  { real[int] tt = T[]; int nh = nanE(tt, "temperature"); }
  if (n == nrelax) {
    { string sv = out; saveCk(n); if (mpirank == 0) { exec("cp " + out + "_ck.txt " + out + "_relaxed_ck.txt"); exec("cp " + out + "_ck.txt.rhoM " + out + "_relaxed_ck.txt.rhoM"); } }
    V = 0; Acc = 0; Wext = 0; Dcum = 0; nneg = 0; T = T0; Tn = T0;   // interface relaxation heat is an initialization artefact
    rhoS = rho0;   // sweeping recovery during the zero-load relaxation is also an initialization artefact
    rhoM = rho0;
    thR = th; rhoG = 0;   // GND counts lattice curvature produced after relaxation only
    curlFpG(GR1, GR2);   // incompatibility present at the end of relaxation is the reference
    E0 = kinU() + kinT() + elasticEnergy() + storedEnergy() + heat();
    { Wplate = 0; reactionNow(); }
    { real gpm = gmin(phi[].min); if (mpirank == 0) cout << "relaxation done: E0=" << E0 << " min phi=" << gpm << endl; }
    writeVTK("relaxed");
  }
  if (!relax || n == nrelax) {
    mark("output: energies, log, diag, VTK, checkpoint");
    real KEu = kinU(), KEt = kinT(), Ee = elasticEnergy(), Es = storedEnergy(), Q = heat();
    real res = Wext - (KEu + KEt + Ee + Es + Q - E0);
    real[int] sl = abs(pa); tmp = abs(pb); sl += tmp; tmp = abs(pc); sl += tmp;
    Ph slp; slp[] = sl;
    real meanslip = gsum(int2d(Th)(ownP*slp))/100.;
    Ph rs; rs[] = rhoS; real meanrho = gsum(int2d(Th)(ownP*rs))/100.;
    Vh1 thv = th; real thmaxdeg = gmax(max(thv[].max, -thv[].min))*180/pi;
    real gSl = gmax(sl.max), gTm = gmax(T[].max), gRG = gmax(rhoG.max), gPm = gmin(phi[].min);
    log << n << "," << t << "," << Tload << "," << it << "," << locres << "," << KEu << "," << KEt << "," << Ee << "," << Es << ","
        << Q << "," << Wext << "," << Dcum << "," << res << "," << gSl << "," << meanslip << "," << (gTm - T0) << ","
        << thmaxdeg << "," << meanrho << "," << gRG << "," << gPm << "," << nneg;
    plateLog(res);
    log << endl;
    log.flush;
    { real[int] da = Dimp .* areas; real[int] dm = Dmid .* areas; real[int] dh = Dloc .* areas; real[int] ds = Zst .* drho; ds = ds .* areas;
      real gdh = gsumE(dh), gda = gsumE(da), gdm = gsumE(dm), gds = gsumE(ds), gDm = gmin(Dloc.min);
      tlog << n << "," << t << "," << gdh << "," << gda << "," << gdm << "," << dAlgCum << "," << nnegStep << "," << gDm << "," << gds/dt << "," << 1 << endl; tlog.flush; }
    if (diagon) {   // worst elements of this step
      real[int] act = abs(dpa); tmp = abs(dpb); act += tmp; tmp = abs(dpc); act += tmp;
      real[int] lr = abs(ra); tmp = abs(rb); for [i, v : lr] v = max(v, tmp[i]); tmp = abs(rc); for [i, v : lr] v = max(v, tmp[i]);
      Ph phe = phi; real[int] gx = gsx; real[int] gy = gsy;
      real[int] gtn = gx .* gx; tmp = gy .* gy; gtn += tmp; gtn = sqrt(gtn);
      real[int] eEm = eEa; for [i, v : eEm] v = max(v, max(eEb[i], eEc[i]));
      real[int] tam = abs(ta); tmp = abs(tb); for [i, v : tam] v = max(v, tmp[i]); tmp = abs(tcc); for [i, v : tam] v = max(v, tmp[i]);
      // MPI: worst elements over the whole mesh (gathered element arrays, global numbering = serial numbering)
      real[int] Gact = gathE(act), Glr = gathE(lr), GD = gathE(Dloc), Gxc = gathE(xcen[]), Gyc = gathE(ycen[]), Gph = gathE(phe[]), Ggt = gathE(gtn);
      real[int] GrG = gathE(rhoG), GrS = gathE(rhoS), Gts = gathE(tstar), Gdw = gathE(dwst), Gtc = gathE(tauc), Get = gathE(etad), GrM = gathE(rhoMob), GeE = gathE(eEm), Gta = gathE(tam);
      if (mpirank == 0) {
      int[int] ks = [Gact.imax, Glr.imax, GD.imax];
      string[int] tg = ["maxslipinc", "maxlocres", "maxD"];
      for (int q = 0; q < 3; q++) { int k = ks[q];
        real xk = Gxc[k], yk = Gyc[k];
        dlog << n << "," << t << "," << tg[q] << "," << k << "," << ThG[k].label << "," << xk << "," << yk << "," << min(min(xk, 10 - xk), min(yk, 10 - yk)) << ","
             << Gph[k] << "," << Ggt[k] << "," << GrG[k] << "," << GrS[k] << "," << Gact[k] << "," << Glr[k] << ","
             << Gts[k] << "," << Gdw[k] << "," << Gtc[k] << "," << Get[k] << "," << GD[k] << "," << (gTm - T0) << "," << GrM[k] << "," << GeE[k] << "," << Gta[k] << "," << Gact[k]/dt/(GrM[k]*b) << endl; }
      dlog.flush;
      }
    }
    if (n % 50 == 0) if (mpirank == 0) cout << "step " << n << " t=" << t << " it=" << it << " KE=" << KEu << " Wext=" << Wext << " res=" << res
                          << " maxslip=" << gSl << " dTmax=" << (gTm - T0) << "  wall=" << (mpiWtime() - wclk0) << " s (cpu " << (clock() - clk0) << " s)" << endl;
  }
  real tt = t + 1e-9;
  if (!relax && (abs(t - 2) < dt/2 || abs(t - 5) < dt/2 || abs(t - 7) < dt/2 || abs(t - 10) < dt/2 || abs(t - tend) < dt/2))
    writeVTK("t" + lrint(t*100));
  if (!relax && vtkevery > 0) { if ((n - nrelax) % vtkevery == 0) writeVTK("s" + (n - nrelax)); }   // (no short-circuit &&)
  if (nanHit) {   // NaN during the commit of this step: do not overwrite any checkpoint with it
    if (mpirank == 0) { ofstream fn(out + "_NAN.txt", append); fn << "stopped during the commit of step " << n << "; restart from the last regular or rolling checkpoint (" << out << "_ck.txt / _ckroll*.txt)" << endl; }
    if (mpirank == 0) cout << "NaN during commit of step " << n << ": stopped without writing a checkpoint" << endl; break; }
  mark("output: checkpoints");
  if (n % ckevery == 0 || n == ntot) saveCk(n);
  if (ckRoll > 0) { if (n % ckRoll == 0) saveCkA(n, out + "_ckroll" + ((n/ckRoll) % 2) + ".txt"); }   // (FreeFem && does not short-circuit: no n % 0)
  real gTst = gmax(T[].max);
  if (!relax && (!(gTst < tstop) || !(gTst > 0))) {
    writeVTK("tstop" + n); saveCk(n);
    if (mpirank == 0) { ofstream ft(out + "_TSTOP.txt"); ft << "stopped at step " << n << " t=" << t << " ns: max T = " << gTst << " K exceeded tstop = " << tstop << " K (or NaN)" << endl; }
    if (mpirank == 0) cout << "TSTOP at step " << n << " t=" << t << " max T=" << gTst << endl; break; }
  if (gmax(mpiWtime() - wclk0) > walllimit) { saveCk(n); if (mpirank == 0) cout << "wall limit reached at step " << n << "; checkpoint written" << endl; break; }
}
if (mpirank == 0) cout << "done. wall time " << (mpiWtime() - wclk0) << " s (cpu " << (clock() - clk0) << " s);  unconverged steps " << nfail << ", retries " << nretry << ", line-search halvings " << lsTot << ", steps converged on du only (residual floor) " << nDuOnly << ", ILU factorizations " << nPre << ", GMRES fallbacks " << nLinFall << " (max GMRES residual " << linResMax << ")" << endl;
if (mpirank == 0) cout << "safeguard counters: det F bound rejections " << nJBad << ", stagnation abandons " << nStag << ", line-search failures " << nLsFail << ", phase-field failures " << nPhiFail << ", bound-pinned node-iterations " << nPhiPin << ", SSD-floor steps " << nFloorSteps << " (elements " << nFloorEl << ", stored-energy credit " << EfloorCum << ")" << ", W_plate " << Wplate << endl;
