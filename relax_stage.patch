+#!/bin/bash
+# Relaxation stage of variant A (zero-load interface relaxation, -nrelax 100 steps at dt = 0.01 ns, eta_phi = 1e-3 GPa ns).
+# If relax_checkpoint.txt exists and was made with the current physics/solver parameters (relax_checkpoint.txt.args), it does nothing.
+# Otherwise it runs the relaxation from scratch (output in out_relax/) and publishes the relaxed checkpoint as relax_checkpoint.txt;
+# every loaded run (run_piston_mob[_mpi].sh) then starts from a copy of it, with the end-of-relaxation reset (-relaxfix 1).
+# usage: bash run_relax.sh            (from this directory; the submit scripts schedule it as a job before the ladder)
+#   env: MPI (1 = FreeFem++-mpi through run_piston_mob_mpi.sh, default; 0 = serial through run_piston_mob.sh), NP (MPI ranks),
+#        RELAXCK (file name, default relax_checkpoint.txt), RELAXCHECK (0 = accept an existing file without the parameter check),
+#        NRELAX (100 relaxation steps), and every physics variable of run_piston_mob_mpi.sh (KWC*, ETASTAR, ETAPHIMIN, CD, ...): they must be the same as in the loaded runs.
+set -uo pipefail
+cd "$(dirname "$0")"
+L=run_piston_mob_mpi.sh; [ "${MPI:-1}" = 0 ] && L=run_piston_mob.sh
+RELAXONLY=1 bash $L 0 0 ${RAMP:-0.5} ${HOLD:-2.0} ${VTKEVERY:-10} A
